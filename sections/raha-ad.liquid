      <div class="rend"><span class="rstar">✦</span> RAHA — راحة <span class="rstar">✦</span></div>
    </div>
  </div>
  <script>
    function rahaWA(n,p){window.open('https://wa.me/212707975742?text='+encodeURIComponent('السلام عليكم 👋\n\nبغيت نطلب من RAHA:\n• '+n+'\n• الثمن: '+p+' DH\n\nالعنوان: \nالهاتف: '),'_blank')}
